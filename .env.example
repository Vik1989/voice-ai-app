# 1. Cloud Provider API Keys (Fill in whichever you use)
# Get free Gemini key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Get OpenAI key from: https://platform.openai.com/
OPENAI_API_KEY=

# 2. Default Provider: "gemini", "openai", or "local"
DEFAULT_PROVIDER=gemini

# 3. Model Preferences
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
LOCAL_MODEL=qwen2.5-coder:3b

# 4. Local Ollama Server
LOCAL_OLLAMA_URL=http://localhost:11434
